AI_PROVIDER=ollama

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=60

# Required only when AI_PROVIDER=groq. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
