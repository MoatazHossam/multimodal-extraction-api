GROQ_TIMEOUT_SECONDS=60
PADDLE_TEXT_DETECTION_MODEL=PP-OCRv5_mobile_det
PADDLE_TEXT_RECOGNITION_MODEL=arabic_PP-OCRv5_mobile_rec
